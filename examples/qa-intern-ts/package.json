{
  "name": "solari-qa-intern-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "demo": "tsx src/main.ts --demo",
    "demo-app": "python3 demo-app/server.py --port 3000",
    "typecheck": "tsc --noEmit",
    "pretest:offline": "patchright-core install chromium-headless-shell",
    "test:offline": "tsx test/offline.ts",
    "test:live": "tsx test/live.ts",
    "pretest:intern": "patchright-core install chromium-headless-shell",
    "test:intern": "tsx test/intern-offline.ts",
    "test": "npm run typecheck && npm run test:offline && npm run test:intern"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@solarisdk/browser": "^0.1.2",
    "@solarisdk/sdk": "^0.1.2",
    "patchright-core": "1.62.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
